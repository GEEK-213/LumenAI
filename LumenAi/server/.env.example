# Lumen AI - Server Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to Git.

# --- Google Gemini (Primary AI) ---
# Option A: Single key (legacy, still works)
Gemini_API_key=YOUR_GEMINI_API_KEY_HERE

# Option B: Multiple keys for quota rotation (recommended)
# The system round-robins through these when one hits 429 quota limits
# GEMINI_KEYS=key1,key2,key3

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase JWT (for API Auth) ---
# Find this in Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Local LLM Fallback (Ollama) ---
# Model to use when Gemini is unavailable
# Run: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Whisper model for local audio transcription
# Options: tiny, base, small, medium, large (larger = slower but more accurate)
WHISPER_MODEL=base
